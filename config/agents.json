      "dependencies": ["fe-001"],
      "promptTemplate": "prompts/frontend/quality-check.md",
      "configuration": {
        "lighthouseConfig": {
          "categories": ["performance", "accessibility", "best-practices", "seo"],
          "thresholds": {
            "performance": 90,
            "accessibility": 95,
            "seo": 90
          }
        }
      }
