{
  "agents": [
    {
      "id": "arch-001",
      "name": "Technical Documentation Agent",
      "category": "architecture",
      "phase": "Architecture Design",
      "owner": "Tuan Do",
      "responsibilities": [
        "Design overall system architecture and component diagrams",
        "Define microservices boundaries and communication patterns",
        "Create technical architecture documentation",
        "Establish architectural principles and patterns"
      ],
      "priority": "high",
      "tools": [
        "Claude AI",
        "GitHub Copilot",
        "Cursor"
      ],
      "mcpServers": [],
      "inputs": [
        {
          "name": "requirements",
          "type": "document",
          "required": true,
          "description": "Business and technical requirements"
        },
        {
          "name": "constraints",
          "type": "object",
          "required": false,
          "description": "Technical and business constraints"
        }
      ],
      "outputs": [
        {
          "name": "architectureDocument",
          "type": "markdown",
          "description": "Comprehensive architecture documentation"
        },
        {
          "name": "componentDiagrams",
          "type": "diagrams",
          "description": "System component diagrams"
        },
        {
          "name": "architecturalPrinciples",
          "type": "document",
          "description": "Architectural principles and patterns"
        }
      ],
      "dependencies": [],
      "promptTemplate": "prompts/architecture/technical-documentation.md",
      "configuration": {
        "diagramFormat": ["C4", "UML"],
        "documentationStyle": "ADR",
        "architecturePatterns": ["microservices", "event-driven", "layered"]
      }
    },
    {
      "id": "arch-002",
      "name": "Technical Requirement Analysis Agent",
      "category": "architecture",
      "phase": "Architecture Design",
      "owner": "Tuan Do",
      "responsibilities": [
        "Analyze business and technical requirements",
        "Create question lists for stakeholders and clarification",
        "Develop Work Breakdown Structure (WBS)",
        "Identify technical constraints and dependencies",
        "Define functional and non-functional requirements",
        "Create requirement traceability matrix"
      ],
      "priority": "high",
      "tools": [
        "Claude AI",
        "GitHub Copilot",
        "Cursor"
      ],
      "mcpServers": [],
      "inputs": [
        {
          "name": "businessRequirements",
          "type": "document",
          "required": true,
          "description": "Business requirements and objectives"
        },
        {
          "name": "stakeholders",
          "type": "array",
          "required": true,
          "description": "List of stakeholders"
        }
      ],
      "outputs": [
        {
          "name": "analysisDocument",
          "type": "markdown",
          "description": "Requirements analysis document"
        },
        {
          "name": "wbs",
          "type": "structured",
          "description": "Work Breakdown Structure"
        },
        {
          "name": "traceabilityMatrix",
          "type": "spreadsheet",
          "description": "Requirement traceability matrix"
        },
        {
          "name": "clarificationQuestions",
          "type": "document",
          "description": "Questions for stakeholders"
        }
      ],
      "dependencies": [],
      "promptTemplate": "prompts/architecture/requirement-analysis.md",
      "configuration": {
        "requirementTypes": ["functional", "non-functional", "technical"],
        "analysisDepth": "comprehensive"
      }
    },
    {
      "id": "arch-003",
      "name": "Drawing Agent",
      "category": "architecture",
      "phase": "Architecture Design",
      "owner": "Tuan Do",
      "responsibilities": [
        "Create system architecture diagrams (C4 model, UML)",
        "Design database ER diagrams and schema visualizations",
        "Draw component and deployment diagrams",
        "Create sequence and activity diagrams",
        "Design network topology and infrastructure diagrams",
        "Generate flowcharts for complex processes"
      ],
      "priority": "high",
      "tools": [
        "Claude AI",
        "GitHub Copilot",
        "Cursor"
      ],
      "mcpServers": [],
      "inputs": [
        {
          "name": "architectureSpec",
          "type": "document",
          "required": true,
          "description": "Architecture specification"
        },
        {
          "name": "diagramType",
          "type": "string",
          "required": true,
          "description": "Type of diagram to create"
        }
      ],
      "outputs": [
        {
          "name": "diagrams",
          "type": "mermaid|plantuml|draw.io",
          "description": "Generated diagrams in requested format"
        },
        {
          "name": "diagramDescription",
          "type": "markdown",
          "description": "Description and explanation of diagrams"
        }
      ],
      "dependencies": ["arch-001"],
      "promptTemplate": "prompts/architecture/drawing-agent.md",
      "configuration": {
        "supportedFormats": ["mermaid", "plantuml", "draw.io", "lucidchart"],
        "diagramTypes": ["c4", "uml", "er", "sequence", "component", "deployment", "flowchart"]
      }
    },
    {
      "id": "fe-001",
      "name": "UI Builder Agent",
      "category": "frontend",
      "phase": "Front-end Development",
      "owner": "Quang Truong",
      "responsibilities": [
        "Implement UI from Figma design",
        "Implement logic",
        "Implement unit test"
      ],
      "priority": "high",
